# Application
APP_URL=http://localhost:5173
# Keep false locally. Set true only to expose the demo Larkbase read-only without SSO.
DEPLOYMENT_DEMO_MODE=false
SESSION_SECRET=replace-with-at-least-32-random-characters
DATA_CACHE_TTL_MS=120000

# Larkbase (server only)
LARK_APP_ID=your-lark-app-id
LARK_APP_SECRET=your-lark-app-secret
LARK_APP_TOKEN=your-lark-base-app-token
LARK_TABLE_ID=your-lark-table-id

# ATINO HUB OAuth (server only except the public URLs)
ATINO_CLIENT_ID=your-atino-client-id
ATINO_CLIENT_SECRET=your-atino-client-secret
ATINO_AUTHORIZATION_URL=https://your-atino-hub.example.com/authorize
ATINO_TOKEN_URL=https://your-atino-hub.example.com/api/public/oauth/token
ATINO_USERINFO_URL=https://your-atino-hub.example.com/api/public/oauth/userinfo
ATINO_REDIRECT_URI=http://localhost:5173/auth/callback
